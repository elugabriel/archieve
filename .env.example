# Copy this file to .env and fill in the values. .env is gitignored.

# REQUIRED. Secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# AI image generation (Gemini). Leave GEMINI_API_KEY blank to disable the feature.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Optional overrides (sensible defaults are used if unset) ---

# Per-account storage allowance, in bytes. Default is 3 GB.
# USER_STORAGE_LIMIT=3221225472

# Database. Defaults to a local SQLite file under instance/.
# DATABASE_URL=sqlite:///clouddrive.db

# Absolute path for uploaded files. Defaults to <project>/static/uploads.
# On PythonAnywhere, set this to an absolute path under your home dir.
# UPLOAD_FOLDER=/home/YOURUSER/Cynthia/static/uploads

# Set to false only when testing over plain http locally.
# SESSION_COOKIE_SECURE=true
